# Secrets and local environment
.env
.venv/

# Terraform: local state holds resource ids, so it stays out of git; the build
# folder is regenerated by scripts/build_lambda.sh. .terraform.lock.hcl IS committed.
.terraform/
*.tfstate
*.tfstate.*
infra/build/

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

# Generated data is never committed -- it is reproducible from (seed, as-of)
data/raw/*
!data/raw/.gitkeep
data/truth/
data/faults.jsonl
data/app_view.csv
